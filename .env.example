# Brev Data Platform - Environment Variables
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git!

# =============================================================================
# NVIDIA NGC
# =============================================================================
# Get from: https://ngc.nvidia.com/setup/api-key
NGC_API_KEY=nvapi-your-key-here

# =============================================================================
# GitHub
# =============================================================================
# Get from: https://github.com/settings/tokens
# Required scopes: repo, read:packages
GITHUB_PAT=ghp_your-token-here
GITHUB_REPO=aerugo/brev-data-platform

# =============================================================================
# MinIO
# =============================================================================
# Generate strong passwords: openssl rand -base64 24
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-to-strong-password

# =============================================================================
# LakeFS
# =============================================================================
# Generate keys:
#   Access key: openssl rand -hex 10 | tr '[:lower:]' '[:upper:]'
#   Secret key: openssl rand -base64 32
LAKEFS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
LAKEFS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# =============================================================================
# Brev Instance
# =============================================================================
BREV_INSTANCE_NAME=brev-data-platform-dev
# Available GPU types: n1-highmem-4:nvidia-tesla-t4:1, etc.
# Check Brev docs for current options
BREV_GPU_TYPE=n1-highmem-4:nvidia-tesla-t4:1
